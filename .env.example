# Copy this file to .env and fill in what you use. .env is git-ignored.

# Which LLM to use: gemini | claude | ollama | mock
# If unset: gemini when GEMINI_API_KEY is set, else claude when ANTHROPIC_API_KEY is set, else mock.
QUOTE_AGENT_PROVIDER=gemini

# Google Gemini - free tier key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# How long newer Gemini models 'think' first: low (fast, default) / medium / high
# GEMINI_THINKING_LEVEL=low

# Anthropic Claude - key from https://platform.claude.com
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-haiku-5-5

# Ollama - local, free. Install from https://ollama.com and `ollama pull llama3.1`
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# HubSpot private app token (free CRM). Leave empty for dry-run mode.
HUBSPOT_TOKEN=

# Seconds to wait for an LLM answer before giving up (default 180)
# QUOTE_AGENT_LLM_TIMEOUT=180
